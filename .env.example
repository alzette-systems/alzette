# Local Compose database. Replace the password for any shared or remote host.
POSTGRES_DB=alzette
POSTGRES_USER=alzette
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=55432

# Keep this on loopback unless the HTTP endpoints are protected by a trusted
# network or TLS reverse proxy. PostgreSQL remains loopback-only regardless.
ALZETTE_HTTP_BIND_ADDRESS=127.0.0.1
ALZETTE_GATEWAY_PORT=8080
ALZETTE_CONTROL_PORT=8081
ALZETTE_PUBLIC_PORT=8082
ALZETTE_BILLING_WEBHOOK_BIND_ADDRESS=127.0.0.1
ALZETTE_BILLING_WEBHOOK_PORT=8083
ALZETTE_CASDOOR_PORT=19084

# This is the customer-visible gateway origin shown in copy-safe first-call
# instructions; it is never inferred from the control service origin.
ALZETTE_PUBLIC_GATEWAY_URL=http://127.0.0.1:8080
ALZETTE_PUBLIC_CONTROL_URL=http://127.0.0.1:8081
# The standalone public site redirects /client to this human login URL.
ALZETTE_PUBLIC_PORTAL_URL=http://127.0.0.1:8081/login
# The reference Compose deployment is explicitly HTTP/LAN development. Set
# both this and COOKIE_SECURE for HTTPS before remote or shared-host use.
ALZETTE_ALLOW_INSECURE_PUBLIC_GATEWAY=true
ALZETTE_PORTAL_COOKIE_SECURE=false
ALZETTE_PORTAL_SESSION_TTL=12h

# Loopback-only Casdoor development identity service. Replace every credential,
# use exact HTTPS origins, and disable the insecure override before remote use.
ALZETTE_WORKFORCE_OIDC_ISSUER=http://casdoor.localhost:19084
ALZETTE_WORKFORCE_OIDC_CLIENT_ID=alzette-local-workforce
ALZETTE_WORKFORCE_OIDC_CLIENT_SECRET=local-workforce-client-secret-change-before-remote-use
ALZETTE_WORKFORCE_OIDC_REDIRECT_URL=http://127.0.0.1:8081/login/oidc/callback
ALZETTE_WORKFORCE_OIDC_SIGNUP_URL=http://casdoor.localhost:19084/signup/oauth/authorize
ALZETTE_WORKFORCE_AGENT_OIDC_REDIRECT_URL=http://127.0.0.1:43127/callback

# Remote dashboard-server ingress (compose.traefik.yaml). The apex domain is
# reserved for the landing-page server.
TRAEFIK_NETWORK=traefik-net
TRAEFIK_ENTRYPOINT=web
ALZETTE_CONTROL_HOST=app.alzette.systems
ALZETTE_AUTH_HOST=auth.alzette.systems
ALZETTE_GATEWAY_HOST=inference.alzette.systems
ALZETTE_ALLOW_INSECURE_WORKFORCE_OIDC=true
ALZETTE_CASDOOR_ADMIN_PASSWORD=123
ALZETTE_CASDOOR_DEMO_USERNAME=employee
ALZETTE_CASDOOR_DEMO_PASSWORD=employee-demo-password
ALZETTE_CASDOOR_DEMO_EMAIL=employee@example.test

# Slice 2 reconciliation runs continuously. Compatible target probes require
# both this global switch and per-target --probe-enabled provisioning; both are
# off by default and must not be enabled with an unapproved provider key.
ALZETTE_ROLLUP_INTERVAL=1m
ALZETTE_ROLLUP_LOOKBACK=48h
ALZETTE_WORKER_HEALTH_MAXIMUM_AGE=5m
ALZETTE_ENABLE_TARGET_PROBES=false

# Billing is disabled by default. When explicitly enabled, Alzette/DUCHENE is
# the merchant of record and each organisation is an ordinary Stripe Customer;
# no customer Stripe account or card data enters Alzette. Use Stripe test-mode
# files and HTTPS return URLs for sandbox validation.
ALZETTE_BILLING_PROVIDER=disabled
STRIPE_SECRET_KEY_SECRET_FILE=/dev/null
STRIPE_WEBHOOK_SECRET_SECRET_FILE=/dev/null
ALZETTE_STRIPE_ALLOW_LIVE_MODE=false
ALZETTE_BILLING_SUCCESS_URL=
ALZETTE_BILLING_CANCEL_URL=
ALZETTE_BILLING_RETURN_URL=

# Provider configuration is operator-side only. Compose mounts the file at
# /run/secrets/openrouter_api_key; it never interpolates the key into its model.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=provider/model-slug
# Comma-separated server-side secret references the gateway may resolve.
ALZETTE_PROVIDER_SECRET_REFS=OPENROUTER_API_KEY,DEEPSEEK_API_KEY
# Keep /dev/null for an inert local stack. Before an approved external call,
# point this at a newly rotated provider-key file that is readable by the
# image's non-root runtime user (for example 0640 with a dedicated group).
OPENROUTER_API_KEY_SECRET_FILE=/dev/null
# Optional direct DeepSeek-compatible target. The URL and provider model belong
# to the operator target registry; only its credential is mounted from a file.
DEEPSEEK_API_KEY_SECRET_FILE=/dev/null

# Keep false for OpenRouter and all Internet targets. Enable only for an
# explicitly approved local/private compatible target during isolated testing.
ALZETTE_ALLOW_INSECURE_TARGETS=false
